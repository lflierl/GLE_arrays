size 12 12

! Two source arrays
a[1] = 10
a[2] = 20
a[3] = 30

b[1] = 2
b[2] = 4
b[3] = 5

! Array-to-array operations
c = a + b
d = a - b
e = a * b
f = a / b

! Expected:
! c: 12, 24, 35
! d: 8, 16, 25
! e: 20, 80, 150
! f: 5, 5, 6
print(c[1])
print(c[2])
print(c[3])
print(d[1])
print(d[2])
print(d[3])
print(e[1])
print(e[2])
print(e[3])
print(f[1])
print(f[2])
print(f[3])

! Reverse subtraction and division
g = b - a
h = b / a

! Expected:
! g: -8, -16, -25
! h: 0.2, 0.2, 0.166666...
print(g[1])
print(g[2])
print(g[3])
print(h[1])
print(h[2])
print(h[3])

! Source arrays remain unchanged
print(a[1])
print(a[2])
print(a[3])
print(b[1])
print(b[2])
print(b[3])
