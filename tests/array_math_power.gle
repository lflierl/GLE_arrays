! v6.4: element-wise array exponentiation.
a = C(1, 4, 9)
exponents = C(1, 2, 3)

! Array raised to scalar powers.
roots = a^0.5
inverse = a^(-1)
squares = a^2

! Scalar raised to array powers.
scalar_left = 2^a

! Array raised to array powers (element-wise).
pairwise = a^exponents

! Ordinary scalar exponentiation remains unchanged.
scalar = 2^3

print(roots[1])
print(roots[2])
print(roots[3])
print(inverse[1])
print(inverse[2])
print(inverse[3])
print(squares[1])
print(squares[2])
print(squares[3])
print(scalar_left[1])
print(scalar_left[2])
print(scalar_left[3])
print(pairwise[1])
print(pairwise[2])
print(pairwise[3])
print(scalar)
